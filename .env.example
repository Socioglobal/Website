# ---------------------------------------------------------------------------
# GoHighLevel
# ---------------------------------------------------------------------------
# Every form on the site posts to /api/lead, which forwards to GHL. Configure
# either transport, or both. With neither set, leads are logged server-side
# only, so nothing is silently dropped in development.

# --- Transport 1: API v2 (preferred) ---------------------------------------
# Sub-account (location) → Settings → Private Integrations → create a token
# with the scopes: contacts.write, contacts.readonly, opportunities.write.
# Contacts are upserted by email, so repeat submissions update rather than
# duplicate, and the enquiry detail is attached to the contact as a note.
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Only change if GHL publishes a newer dated API version.
GHL_API_VERSION=2021-07-28

# Optional. Custom field ids differ per location, so map our field names to
# yours as JSON. Find the ids under Settings → Custom Fields. Unmapped values
# are simply left out — they still appear in the contact note.
# Mappable names: companySize, outboundApproach, tier, segment, avgDealValue,
# dealsPerMonth, targetDealsPerMonth, closeRatePercent, monthlyGap, annualGap,
# meetingsNeeded
GHL_CUSTOM_FIELD_MAP=

# Optional. Set both to open an opportunity in a pipeline stage for every lead.
# Calculator leads carry their annual revenue gap as the opportunity value.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Testing only: point the API transport at a mock server instead of GHL.
# Leave unset in every real environment.
GHL_API_BASE=

# --- Transport 2: inbound webhook ------------------------------------------
# Simpler alternative: in a GHL workflow add an "Inbound Webhook" trigger and
# paste its URL here. No token required; the workflow creates the contact.
GHL_WEBHOOK_URL=

# --- Booking calendar ------------------------------------------------------
# GHL calendar id. With this set, /book-a-call renders the live GHL booking
# widget; without it, the page shows a placeholder and the form still works.
# Calendars → your calendar → Share → the id is the last path segment of the
# booking link (link.msgsndr.com/widget/booking/<id>).
NEXT_PUBLIC_GHL_CALENDAR_ID=

# ---------------------------------------------------------------------------
# Generic CRM (optional)
# ---------------------------------------------------------------------------
# Escape hatch for any non-GHL destination — Zapier, Make, n8n, your own API.
# Runs in addition to the GHL transports above.
CRM_WEBHOOK_URL=
# Sent as "Authorization: Bearer ..." on both webhook transports.
CRM_WEBHOOK_SECRET=
